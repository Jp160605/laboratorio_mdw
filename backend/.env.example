# Puerto de la API
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=reservas_db

# Caché y Colas Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Autenticación JWT
JWT_SECRET=clave_secreta_jwt_para_firmar_tokens_12345
JWT_EXPIRES_IN=8h

# Notificaciones por Correo (SMTP Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@universidad.edu
SMTP_PASS=contrasena_o_app_password
SMTP_FROM="Sistema de Reservas" <notificaciones@universidad.edu>
